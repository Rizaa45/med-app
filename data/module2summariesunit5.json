[
  {
    "id": 5,
    "title": "Degenerative Erkrankungen und Folgen von Immobilität",
    "tags": [
      "Osteoporose",
      "Immobilität",
      "Knochenstoffwechsel",
      "Prophylaxe"
    ],
    "content": "<div class='space-y-10 pb-10'>\n\n  <!-- Header-Box -->\n  <div class='bg-indigo-50 p-8 rounded-3xl border border-indigo-100 shadow-sm'>\n    <h2 class='text-2xl font-black text-indigo-900 mb-2 uppercase tracking-tight'>Zusammenfassung: Mobilität & Degeneration</h2>\n    <p class='text-indigo-700 leading-relaxed font-medium'>\n      Dieses Kapitel befasst sich mit den pathologischen Veränderungen des Knochenapparates im Alter, primär der Osteoporose, sowie den weitreichenden physischen und psychischen Komplikationen, die durch längerfristige Immobilität entstehen können.\n    </p>\n  </div>\n\n  <!-- Sektion 1: Osteoporose -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>1</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Krankheitsbild Osteoporose</h3>\n    </div>\n    \n    <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>\n      <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm'>\n        <h4 class='text-indigo-600 font-black text-xs uppercase mb-3 tracking-widest'>Definition & Pathophysiologie</h4>\n        <p class='text-slate-600 text-sm leading-relaxed'>\n          Osteoporose bezeichnet einen <strong>krankhaften Knochenschwund</strong>, bei dem die Belastbarkeit der Knochenbälkchen (Spongiosa) massiv sinkt. Besonders frakturgefährdet sind die Wirbelkörper und der Oberschenkelknochen.\n        </p>\n      </div>\n      <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm'>\n        <h4 class='text-indigo-600 font-black text-xs uppercase mb-3 tracking-widest'>Klinische Merkmale</h4>\n        <ul class='text-slate-600 text-sm space-y-2'>\n          <li class='flex items-center gap-2'><i class='fas fa-exclamation-triangle text-orange-500 text-[10px]'></i> <strong>Witwenbuckel:</strong> Kyphose der BWS.</li>\n          <li class='flex items-center gap-2'><i class='fas fa-exclamation-triangle text-orange-500 text-[10px]'></i> <strong>Tannenbaumphänomen:</strong> Seitliche Hautfalten am Rücken.</li>\n          <li class='flex items-center gap-2'><i class='fas fa-exclamation-triangle text-orange-500 text-[10px]'></i> <strong>Wirbelfrakturen:</strong> Führen zu Größenverlust.</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 2: Knochenstoffwechsel (Highlight-Card) -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>2</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Physiologie des Knochens</h3>\n    </div>\n\n    <div class='bg-slate-900 text-white p-8 rounded-[2rem] shadow-xl relative overflow-hidden'>\n      <div class='absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl'></div>\n      <h4 class='text-indigo-400 font-black text-sm uppercase mb-6 tracking-widest italic'>Bedarfsfaktoren für gesunden Knochen</h4>\n      <div class='grid grid-cols-2 md:grid-cols-3 gap-6 relative z-10'>\n        <div class='bg-white/5 p-4 rounded-xl border border-white/10 text-center'>\n          <div class='text-indigo-300 font-bold text-lg mb-1'>Kalzium</div>\n          <div class='text-[9px] uppercase text-slate-400'>Basisbaustein (Ca2+)</div>\n        </div>\n        <div class='bg-white/5 p-4 rounded-xl border border-white/10 text-center'>\n          <div class='text-indigo-300 font-bold text-lg mb-1'>Vitamin D</div>\n          <div class='text-[9px] uppercase text-slate-400'>Aktiviert durch Licht</div>\n        </div>\n        <div class='bg-white/5 p-4 rounded-xl border border-white/10 text-center'>\n          <div class='text-indigo-300 font-bold text-lg mb-1'>Bewegung</div>\n          <div class='text-[9px] uppercase text-slate-400'>Mechanischer Reiz</div>\n        </div>\n        <div class='bg-white/5 p-4 rounded-xl border border-white/10 text-center'>\n          <div class='text-indigo-300 font-bold text-lg mb-1'>Sauerstoff</div>\n          <div class='text-[9px] uppercase text-slate-400'>Zellversorgung</div>\n        </div>\n        <div class='bg-white/5 p-4 rounded-xl border border-white/10 text-center'>\n          <div class='text-indigo-300 font-bold text-lg mb-1'>Osteoblasten</div>\n          <div class='text-[9px] uppercase text-slate-400'>Knochenaufbau</div>\n        </div>\n        <div class='bg-white/5 p-4 rounded-xl border border-white/10 text-center'>\n          <div class='text-indigo-300 font-bold text-lg mb-1'>Osteoklasten</div>\n          <div class='text-[9px] uppercase text-slate-400'>Knochenabbau</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 3: Physische Folgen der Immobilität -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>3</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Körperliche Sekundärerkrankungen</h3>\n    </div>\n\n    <div class='bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden'>\n      <table class='w-full text-left'>\n        <thead class='bg-slate-50 text-slate-500'>\n          <tr>\n            <th class='px-6 py-4 text-xs font-black uppercase tracking-widest'>Risikobereich</th>\n            <th class='px-6 py-4 text-xs font-black uppercase tracking-widest'>Folgeerscheinung</th>\n          </tr>\n        </thead>\n        <tbody class='divide-y divide-slate-100 text-sm'>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700'>Integument & Gefäße</td>\n            <td class='px-6 py-4 text-slate-600'>Dekubitusrisiko, Thromboserisiko</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700'>Bewegungsapparat</td>\n            <td class='px-6 py-4 text-slate-600 italic'>Kontrakturrisiko (Gelenkversteifung)</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700'>Stoffwechsel & Organe</td>\n            <td class='px-6 py-4 text-slate-600'>Nieren-, Herz- oder Lungenerkrankungen, Elektrolytentgleisung</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700'>Ausscheidung & Abwehr</td>\n            <td class='px-6 py-4 text-slate-600'>Inkontinenz, Infektionsrisiko (z.B. Pneumonie)</td>\n          </tr>\n          <tr class='bg-orange-50/30'>\n            <td class='px-6 py-4 font-bold text-orange-700 italic'>Kreislaufadaption</td>\n            <td class='px-6 py-4 text-orange-800 font-medium'>Verminderung orthostatischer Reaktionen</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- Sektion 4: Psychosoziale Auswirkungen -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>4</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Psychosozialer Teufelskreis</h3>\n    </div>\n\n    <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>\n      <div class='bg-white border border-slate-200 p-5 rounded-2xl shadow-sm border-t-4 border-t-indigo-400'>\n        <span class='text-[10px] font-black text-indigo-500 uppercase block mb-2'>Kognition</span>\n        <p class='text-xs text-slate-600'>Verkümmernde kognitive Fähigkeiten durch mangelnde Reize.</p>\n      </div>\n      <div class='bg-white border border-slate-200 p-5 rounded-2xl shadow-sm border-t-4 border-t-indigo-400'>\n        <span class='text-[10px] font-black text-indigo-500 uppercase block mb-2'>Psyche</span>\n        <p class='text-xs text-slate-600'>Verlust von Selbstvertrauen und Lebensmut; zunehmende Angst.</p>\n      </div>\n      <div class='bg-white border border-slate-200 p-5 rounded-2xl shadow-sm border-t-4 border-t-indigo-400'>\n        <span class='text-[10px] font-black text-indigo-500 uppercase block mb-2'>Soziales</span>\n        <p class='text-xs text-slate-600'>Verlust kommunikativer Fähigkeiten durch fehlende Kontakte.</p>\n      </div>\n    </div>\n  </div>\n\n</div>"
  }
]
