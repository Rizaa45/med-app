[
  {
    "id": 4,
    "title": "Rechtliche Grundlagen des Medizinprodukterechts",
    "tags": [
      "MPDG",
      "MDR",
      "Medizinprodukte",
      "Betreiberpflichten",
      "Haftung"
    ],
    "content": "<div class='space-y-10 pb-10'>\n\n  <!-- Header-Box -->\n  <div class='bg-indigo-50 p-8 rounded-3xl border border-indigo-100 shadow-sm'>\n    <h2 class='text-2xl font-black text-indigo-900 mb-2 uppercase tracking-tight'>Executive Summary</h2>\n    <p class='text-indigo-700 leading-relaxed font-medium'>\n      Das Medizinprodukterecht regelt in Deutschland die Umsetzung europäischer Vorgaben (MDR/IVDR) zur Inverkehrbringung und zum sicheren Umgang mit Medizinprodukten. Im Fokus steht die Gewährleistung der Patientensicherheit durch klare Abgrenzung zu Arzneimitteln, Risiko-Klassifizierungen und strikte Betreiber- sowie Anwenderpflichten.\n    </p>\n  </div>\n\n  <!-- Sektion 1: Definition & Abgrenzung -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>1</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Medizinprodukt vs. Arzneimittel</h3>\n    </div>\n    \n    <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>\n      <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm border-l-4 border-l-indigo-500'>\n        <h4 class='text-indigo-600 font-black text-xs uppercase mb-3 tracking-widest'>Hauptwirkungsweise</h4>\n        <p class='text-slate-600 text-sm leading-relaxed'>\n          Medizinprodukte wirken primär <strong>physikalisch oder physikochemisch</strong>. Im Gegensatz dazu wirken Arzneimittel pharmakologisch, immunologisch oder metabolisch.\n        </p>\n      </div>\n      <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm border-l-4 border-l-slate-400'>\n        <h4 class='text-slate-500 font-black text-xs uppercase mb-3 tracking-widest'>Zulassung & Kennzeichnung</h4>\n        <p class='text-slate-600 text-sm leading-relaxed'>\n          Medizinprodukte werden nicht zugelassen, sondern durch ein Konformitätsbewertungsverfahren zertifiziert und tragen eine <strong>CE-Kennzeichnung</strong>.\n        </p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 2: Risikoklassen -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>2</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Klassifizierung nach Risiko</h3>\n    </div>\n\n    <div class='bg-slate-900 text-white p-8 rounded-[2.5rem] shadow-xl'>\n      <div class='grid grid-cols-1 md:grid-cols-4 gap-4'>\n        <div class='p-4 bg-white/5 rounded-2xl border border-white/10'>\n          <div class='text-indigo-400 font-black text-xl mb-1'>Klasse I</div>\n          <div class='text-[10px] font-bold text-slate-400 uppercase mb-2'>Geringes Risiko</div>\n          <p class='text-[10px] italic'>Lesebrillen, Rollstühle, Mullbinden.</p>\n        </div>\n        <div class='p-4 bg-white/5 rounded-2xl border border-white/10'>\n          <div class='text-indigo-400 font-black text-xl mb-1'>Klasse IIa</div>\n          <div class='text-[10px] font-bold text-slate-400 uppercase mb-2'>Mittleres Risiko</div>\n          <p class='text-[10px] italic'>Hörgeräte, Ultraschallgeräte, Einmalspritzen.</p>\n        </div>\n        <div class='p-4 bg-white/5 rounded-2xl border border-white/10'>\n          <div class='text-indigo-400 font-black text-xl mb-1'>Klasse IIb</div>\n          <div class='text-[10px] font-bold text-slate-400 uppercase mb-2'>Hohes Risiko</div>\n          <p class='text-[10px] italic'>Beatmungsgeräte, Infusionspumpen, Defibrillatoren.</p>\n        </div>\n        <div class='p-4 bg-red-900/40 rounded-2xl border border-red-500/30'>\n          <div class='text-red-400 font-black text-xl mb-1'>Klasse III</div>\n          <div class='text-[10px] font-bold text-red-300 uppercase mb-2'>Sehr hohes Risiko</div>\n          <p class='text-[10px] italic'>Herzkatheter, Implantate (länger als 30 Tage).</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 3: Betreiberpflichten (MPBetreibV) -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>3</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Betreiber- & Anwenderpflichten</h3>\n    </div>\n\n    <div class='bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden'>\n      <table class='w-full text-left'>\n        <thead class='bg-slate-50'>\n          <tr>\n            <th class='px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest'>Dokument / Maßnahme</th>\n            <th class='px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest'>Anforderung</th>\n          </tr>\n        </thead>\n        <tbody class='divide-y divide-slate-100 text-sm'>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700 italic'>Bestandsverzeichnis</td>\n            <td class='px-6 py-4 text-slate-600'>Pflicht für alle aktiven, nicht implantierbaren Medizinprodukte.</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700 italic'>Medizinproduktebuch</td>\n            <td class='px-6 py-4 text-slate-600'>Erforderlich für Geräte der Anlage 1 & 2; enthält Einweisungsbelege & STK-Protokolle.</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700 italic'>STK</td>\n            <td class='px-6 py-4 text-slate-600 text-indigo-600 font-bold'>Sicherheitstechnische Kontrolle (spätestens alle 2 Jahre).</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700 italic'>MTK</td>\n            <td class='px-6 py-4 text-slate-600 italic'>Messtechnische Kontrolle für Geräte mit Messfunktion.</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- Sektion 4: Haftung & Praxisrelevanz -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>4</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Praxisrelevanz & Forensik</h3>\n    </div>\n\n    <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>\n      <div class='bg-white border border-red-100 p-6 rounded-3xl shadow-sm'>\n        <h4 class='font-black text-red-600 mb-4 border-b border-red-50 pb-2 text-sm uppercase italic'>Übernahmeverschulden</h4>\n        <p class='text-xs text-slate-600 leading-relaxed'>\n          Pflegekräfte haften persönlich, wenn sie ein Gerät bedienen, für das sie <strong>nicht eingewiesen</strong> sind oder keine ausreichende Qualifikation besitzen. Eine Selbsteinschätzung der Kompetenz ist zwingend.\n        </p>\n      </div>\n\n      <div class='bg-white border border-slate-200 p-6 rounded-3xl shadow-sm'>\n        <h4 class='font-black text-slate-800 mb-4 border-b border-slate-100 pb-2 text-sm uppercase italic'>Strafmaß bei Verstößen</h4>\n        <div class='space-y-2'>\n          <div class='flex justify-between items-center bg-slate-50 p-2 rounded-xl'>\n            <span class='text-xs font-bold text-slate-700'>Geldstrafe</span>\n            <span class='text-xs font-black text-red-600'>bis zu 25.000 €</span>\n          </div>\n          <div class='flex justify-between items-center bg-slate-50 p-2 rounded-xl'>\n            <span class='text-xs font-bold text-slate-700'>Freiheitsstrafe</span>\n            <span class='text-xs font-black text-red-600'>bis zu 5 Jahre</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 5: Behörden & Meldewesen -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>5</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Zuständigkeiten</h3>\n    </div>\n    \n    <div class='bg-indigo-900 text-white p-8 rounded-[2.5rem] shadow-xl flex flex-col md:flex-row gap-8 items-center'>\n      <div class='flex-1'>\n        <h4 class='text-indigo-400 font-black text-xs uppercase mb-2 tracking-widest'>Aufsichtsbehörde</h4>\n        <h5 class='text-2xl font-black mb-3'>BfArM (Bonn)</h5>\n        <p class='text-indigo-200 text-xs leading-relaxed italic'>\n          Bundesinstitut für Arzneimittel und Medizinprodukte. Auftretende Gefahren, Risiken oder Funktionsstörungen müssen hierher <strong>unverzüglich</strong> gemeldet werden.\n        </p>\n      </div>\n      <div class='w-px h-24 bg-white/10 hidden md:block'></div>\n      <div class='flex-1'>\n        <h4 class='text-indigo-400 font-black text-xs uppercase mb-2 tracking-widest'>Zulassung (Spezialfälle)</h4>\n        <h5 class='text-2xl font-black mb-3'>Paul-Ehrlich-Institut</h5>\n        <p class='text-indigo-200 text-xs leading-relaxed italic'>\n          Zuständig für die staatliche Freigabe von Chargen bei Impfstoffen und biomedizinischen Arzneimitteln/Geräten.\n        </p>\n      </div>\n    </div>\n  </div>\n\n</div>"
  }
]
