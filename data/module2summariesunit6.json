[
  {
    "id": 6,
    "title": "Pädagogische Anleitung in der Pflege",
    "tags": [
      "Pädagogik",
      "5-Schritte-Modell",
      "Patientenedukation",
      "Pflegekompetenz"
    ],
    "content": "<div class='space-y-10 pb-10'>\n\n  <!-- Header-Box -->\n  <div class='bg-indigo-50 p-8 rounded-3xl border border-indigo-100 shadow-sm'>\n    <h2 class='text-2xl font-black text-indigo-900 mb-2 uppercase tracking-tight'>Executive Summary: Modul 2.6</h2>\n    <p class='text-indigo-700 leading-relaxed font-medium'>\n      Die pädagogische Anleitung ist eine gezielte pflegerische Intervention zur Vermittlung von Fertigkeiten und Kenntnissen. Ziel ist es, Pflegeempfänger, Angehörige oder neue Kollegen so zu befähigen, dass sie Wissen verstehen und eigenständig in die Praxis umsetzen können [1, 2].\n    </p>\n  </div>\n\n  <!-- Sektion 1: Definition & Zielgruppen -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>1</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Grundlagen der Anleitung</h3>\n    </div>\n    \n    <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>\n      <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm border-l-4 border-l-indigo-600'>\n        <h4 class='text-indigo-600 font-black text-xs uppercase mb-3 tracking-widest'>Pädagogische Definition</h4>\n        <p class='text-slate-600 text-sm leading-relaxed'>\n          Anleitung setzt die Fähigkeit voraus, eigene Kompetenzen sinnvoll aufzubereiten. Es geht um die gezielte Einführung in <strong>pflegerische Handlungen, Pflegetechniken oder Arbeitssituationen</strong> [1, 2].\n        </p>\n      </div>\n      <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm border-l-4 border-l-slate-400'>\n        <h4 class='text-slate-500 font-black text-xs uppercase mb-3 tracking-widest'>Adressaten</h4>\n        <ul class='text-slate-600 text-sm space-y-1 font-medium'>\n          <li>• Patienten & Angehörige [2]</li>\n          <li>• Pflegeschüler & Auszubildende [2]</li>\n          <li>• Neue Mitarbeiter [2]</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 2: Das 5-Schritte-Modell -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>2</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Strukturierter Anleitprozess</h3>\n    </div>\n\n    <div class='bg-slate-900 text-white p-8 rounded-[2.5rem] shadow-xl relative overflow-hidden'>\n      <div class='absolute -right-16 -top-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl'></div>\n      <h4 class='text-indigo-400 font-black text-xs uppercase mb-8 tracking-widest text-center'>Das 5-Schritte-Modell der Anleitung [3]</h4>\n      \n      <div class='grid grid-cols-1 md:grid-cols-5 gap-4 relative z-10'>\n        <div class='p-4 bg-white/5 rounded-2xl border border-white/10 text-center'>\n          <div class='text-indigo-400 font-black text-lg mb-1'>01</div>\n          <div class='text-[9px] font-bold uppercase text-slate-300'>Vorwissen aktivieren</div>\n        </div>\n        <div class='p-4 bg-white/5 rounded-2xl border border-white/10 text-center'>\n          <div class='text-indigo-400 font-black text-lg mb-1'>02</div>\n          <div class='text-[9px] font-bold uppercase text-slate-300'>Erarbeitung</div>\n        </div>\n        <div class='p-4 bg-indigo-600 rounded-2xl shadow-lg text-center transform scale-110'>\n          <div class='text-white font-black text-lg mb-1'>03</div>\n          <div class='text-[9px] font-bold uppercase text-indigo-100'>Durchführung</div>\n        </div>\n        <div class='p-4 bg-white/5 rounded-2xl border border-white/10 text-center'>\n          <div class='text-indigo-400 font-black text-lg mb-1'>04</div>\n          <div class='text-[9px] font-bold uppercase text-slate-300'>Vertiefung</div>\n        </div>\n        <div class='p-4 bg-white/5 rounded-2xl border border-white/10 text-center'>\n          <div class='text-indigo-400 font-black text-lg mb-1'>05</div>\n          <div class='text-[9px] font-bold uppercase text-slate-300'>Reflexion</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 3: Evaluation -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>3</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Multiperspektivische Reflexion</h3>\n    </div>\n\n    <div class='bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden'>\n      <table class='w-full text-left'>\n        <thead class='bg-slate-50'>\n          <tr>\n            <th class='px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest'>Perspektive [3]</th>\n            <th class='px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest'>Inhalt der Evaluation</th>\n          </tr>\n        </thead>\n        <tbody class='divide-y divide-slate-100 text-sm italic'>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700'>Der Angeleitete</td>\n            <td class='px-6 py-4 text-slate-600'>Einschätzung des eigenen Lernerfolgs und der Sicherheit [3].</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700'>Der Anleitende</td>\n            <td class='px-6 py-4 text-slate-600'>Reflexion der pädagogischen Vermittlung und Methodik [3].</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700'>Das Plenum</td>\n            <td class='px-6 py-4 text-slate-600 text-indigo-600 font-bold'>Beobachtung der Qualität aus neutraler Sicht [3].</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- Sektion 4: Methodik & Qualität -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>4</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Anleitungsqualität</h3>\n    </div>\n\n    <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>\n      <div class='bg-white border border-slate-200 p-6 rounded-3xl shadow-sm'>\n        <h4 class='font-black text-slate-800 mb-4 border-b pb-2 text-sm uppercase italic'>Methodik im Plenum</h4>\n        <p class='text-xs text-slate-500 leading-relaxed mb-4'>\n          In der Ausbildung werden Anleitungssituationen oft im Rollenspiel entwickelt. Hierbei wird der <strong>Handlungsablauf schriftlich festgehalten</strong> und probeweise durchgeführt [4].\n        </p>\n      </div>\n\n      <div class='bg-white border border-slate-200 p-6 rounded-3xl shadow-sm'>\n        <h4 class='font-black text-slate-800 mb-4 border-b pb-2 text-sm uppercase italic'>Erkenntnisgewinn</h4>\n        <p class='text-xs text-slate-500 leading-relaxed italic'>\n          Gute Anleitung zeichnet sich durch einen Vergleich zwischen initialem Brainstorming („Was ist gute Anleitung?“) und den realen Ergebnissen der praktischen Durchführung aus [3].\n        </p>\n      </div>\n    </div>\n  </div>\n\n</div>"
  }
]
