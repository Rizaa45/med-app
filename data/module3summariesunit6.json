[
  {
    "id": 6,
    "title": "Thermoregulation und Fieberpflege",
    "tags": ["Fieberphasen", "Hypothalamus", "Wadenwickel", "Krisis"],
    "content": "<div class='space-y-10 pb-10 font-sans text-slate-800'>\n\n  <!-- Executive Summary -->\n  <section class='bg-indigo-50 border-l-8 border-indigo-600 p-6 rounded-r-2xl'>\n    <h2 class='text-2xl font-bold text-indigo-900 mb-2'>Executive Summary</h2>\n    <p class='text-indigo-800 leading-relaxed'>\n      Die Thermoregulation ist ein lebenswichtiger Prozess, der im <b>Hypothalamus</b> gesteuert wird, um die Körperkerntemperatur bei ca. 37°C konstant zu halten. Fieber ist dabei keine eigenständige Erkrankung, sondern ein <b>Symptom und Schutzmechanismus</b> des Immunsystems. Die pflegerische Herausforderung liegt in der phasengerechten Unterstützung des Patienten sowie in der Früherkennung lebensbedrohlicher Komplikationen wie der <b>Krisis</b> oder dem <b>Fieberdelir</b>.\n    </p>\n  </section>\n\n  <!-- Strukturierte Diagnostik -->\n  <section class='space-y-4'>\n    <h2 class='text-2xl font-bold text-slate-900 flex items-center'>\n      <span class='bg-indigo-600 text-white px-3 py-1 rounded-lg mr-3 text-sm'>A</span> Diagnostik & Vitalzeichenbeobachtung\n    </h2>\n    <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>\n      <div class='bg-white border border-slate-200 p-5 rounded-2xl shadow-sm'>\n        <h3 class='font-bold text-indigo-700 mb-3 uppercase text-xs tracking-wider'>Temperatur-Klassifizierung</h3>\n        <ul class='space-y-2 text-sm text-slate-600'>\n          <li class='flex justify-between'><span>Normaltemperatur:</span> <span class='font-bold'>36,5 – 37,4 °C</span></li>\n          <li class='flex justify-between'><span>Subfebril:</span> <span class='font-bold'>37,5 – 38,0 °C</span></li>\n          <li class='flex justify-between text-orange-600'><span>Leichtes/Mäßiges Fieber:</span> <span class='font-bold'>38,1 – 39,0 °C</span></li>\n          <li class='flex justify-between text-red-600 font-bold'><span>Hohes Fieber:</span> <span>> 39,1 °C</span></li>\n        </ul>\n        <p class='mt-4 text-[11px] italic'>Ab 38,0 °C spricht man klinisch von Fieber.</p>\n      </div>\n      <div class='bg-white border border-slate-200 p-5 rounded-2xl shadow-sm'>\n        <h3 class='font-bold text-indigo-700 mb-3 uppercase text-xs tracking-wider'>Begleitsymptomatik (Puls & Atmung)</h3>\n        <div class='space-y-3 text-sm'>\n          <div class='p-3 bg-slate-50 rounded-xl'>\n            <p class='font-bold text-slate-700'>Tachykardie:</p>\n            <p class='text-slate-600'>Anstieg um <b>8–12 Schläge/Min</b> pro 1°C Temperaturerhöhung.</p>\n          </div>\n          <div class='p-3 bg-slate-50 rounded-xl'>\n            <p class='font-bold text-slate-700'>Tachypnoe:</p>\n            <p class='text-slate-600'>Sauerstoffbedarf steigt um <b>10%</b> pro 1°C Temperaturerhöhung.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Pathophysiologie & Krankheitsbilder -->\n  <section class='space-y-4'>\n    <h2 class='text-2xl font-bold text-slate-900'>Spezifische Fieberarten & Störungen</h2>\n    <div class='overflow-hidden border border-slate-200 rounded-2xl shadow-lg'>\n      <table class='w-full text-left border-collapse bg-white text-sm'>\n        <thead class='bg-slate-800 text-slate-100'>\n          <tr>\n            <th class='p-4 font-semibold'>Typ</th>\n            <th class='p-4 font-semibold'>Ursache / Pathomechanismus</th>\n            <th class='p-4 font-semibold'>Besonderheit</th>\n          </tr>\n        </thead>\n        <tbody class='divide-y divide-slate-100'>\n          <tr>\n            <td class='p-4 font-medium'>Resorptionsfieber</td>\n            <td class='p-4'>Abbau von Gewebetrümmern/Blut (post-OP).</td>\n            <td class='p-4'>2-3 Tage post-OP, meist < 38,5°C.</td>\n          </tr>\n          <tr class='bg-slate-50'>\n            <td class='p-4 font-medium'>Zentrales Fieber</td>\n            <td class='p-4'>Schädigung des Hypothalamus (SHT, Tumor).</td>\n            <td class='p-4 text-red-600 font-bold'>Antipyretika oft wirkungslos; > 40°C.</td>\n          </tr>\n          <tr>\n            <td class='p-4 font-medium'>Hyperthermie</td>\n            <td class='p-4'>Überwärmung ohne Sollwert-Veränderung.</td>\n            <td class='p-4'>Hitzschlag, Sonnenstich; Lebensgefahr!</td>\n          </tr>\n          <tr class='bg-slate-50'>\n            <td class='p-4 font-medium'>Hypothermie</td>\n            <td class='p-4'>Wärmeverlust > Wärmeproduktion (< 35,0°C).</td>\n            <td class='p-4'>Gefahr bei Temperaturen < 30°C.</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <!-- Maßnahmen nach Fieberphasen -->\n  <section class='space-y-6'>\n    <h2 class='text-2xl font-bold text-slate-900'>Phasengerechte Pflegemaßnahmen</h2>\n    \n    <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>\n      <!-- Fieberanstieg -->\n      <div class='bg-white border border-indigo-100 p-5 rounded-2xl shadow-sm'>\n        <div class='bg-indigo-600 text-white px-3 py-1 rounded-full text-[10px] font-bold uppercase w-max mb-3'>Phase 1: Anstieg</div>\n        <p class='text-xs font-bold mb-2'>Symptom: Schüttelfrost, Frieren</p>\n        <ul class='text-xs space-y-2 text-slate-600'>\n          <li>• <b>Wärmezufuhr:</b> Decken, warme Getränke.</li>\n          <li>• <b>Schutz:</b> Bei Schüttelfrost Verletzungen vermeiden.</li>\n          <li>• <b>Verbot:</b> Noch keine fiebersenkenden Wickel!</li>\n        </ul>\n      </div>\n\n      <!-- Fieberhöhe -->\n      <div class='bg-white border border-indigo-100 p-5 rounded-2xl shadow-sm'>\n        <div class='bg-indigo-600 text-white px-3 py-1 rounded-full text-[10px] font-bold uppercase w-max mb-3'>Phase 2: Höhe</div>\n        <p class='text-xs font-bold mb-2'>Symptom: Hitzegefühl, Rötung</p>\n        <ul class='text-xs space-y-2 text-slate-600'>\n          <li>• <b>Wärmeabfuhr:</b> Leichte Kleidung, kühle Getränke.</li>\n          <li>• <b>Wickel:</b> Wadenwickel (nur wenn Extremitäten warm sind!).</li>\n          <li>• <b>Ernährung:</b> Leicht verdauliche Kost, Flüssigkeitsbilanz.</li>\n        </ul>\n      </div>\n\n      <!-- Fieberabfall -->\n      <div class='bg-white border border-indigo-100 p-5 rounded-2xl shadow-sm'>\n        <div class='bg-indigo-600 text-white px-3 py-1 rounded-full text-[10px] font-bold uppercase w-max mb-3'>Phase 3: Abfall</div>\n        <p class='text-xs font-bold mb-2'>Symptom: Schwitzen</p>\n        <ul class='text-xs space-y-2 text-slate-600'>\n          <li>• <b>Komfort:</b> Wäschewechsel (Bedarf), Hautpflege in Falten.</li>\n          <li>• <b>Kreislauf:</b> Mobilisation unterstützen (Schwäche).</li>\n          <li>• <b>Beobachtung:</b> Achtung auf Krisis-Zeichen!</li>\n        </ul>\n      </div>\n    </div>\n\n    <!-- Pathologische Warnhinweise -->\n    <div class='bg-red-50 text-red-700 p-6 rounded-2xl border border-red-200'>\n      <h3 class='font-bold text-red-800 mb-3 flex items-center'>\n        <svg class='w-6 h-6 mr-2' fill='currentColor' viewBox='0 0 20 20'><path fill-rule='evenodd' d='M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z' clip-rule='evenodd'></path></svg>\n        Notfall-Indikatoren\n      </h3>\n      <div class='grid grid-cols-1 md:grid-cols-2 gap-4 text-sm'>\n        <div>\n          <p class='font-bold'>Krisis (Kritische Entfieberung):</p>\n          <p class='text-xs'>Schneller Abfall innerhalb von Stunden. Symptome: Kalter Schweiß, fädiger Puls, Kollapsgefahr. <b>Sofort Arzt informieren!</b></p>\n        </div>\n        <div>\n          <p class='font-bold'>Fieberdelir / Fieberkrampf:</p>\n          <p class='text-xs'>Bewusstseinseintrübung, Halluzinationen oder tonisch-klonische Krämpfe (v.a. bei Kindern). <b>Sicherheit gewährleisten!</b></p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</div>"
  }
]