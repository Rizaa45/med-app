[
  {
    "id": 1,
    "title": "Notfallmanagement und Erste Hilfe",
    "tags": [
      "ABCDE-Schema",
      "Reanimation",
      "Erste Hilfe",
      "Rechtliche Grundlagen"
    ],
    "content": "<div class='space-y-10 pb-10'>\n\n  <!-- Header-Box -->\n  <div class='bg-indigo-50 p-8 rounded-3xl border border-indigo-100 shadow-sm'>\n    <h2 class='text-2xl font-black text-indigo-900 mb-2 uppercase tracking-tight'>Executive Summary: Modul 2.1</h2>\n    <p class='text-indigo-700 leading-relaxed font-medium'>\n      Dieses Modul fokussiert auf das systematische Management von Notfallsituationen, in denen das Leben gefährdet ist [1]. Im Zentrum stehen die strukturierte Diagnostik nach dem ABCDE-Schema, die Durchführung lebensrettender Sofortmaßnahmen nach den ERC-Leitlinien 2021 sowie die Beachtung rechtlicher Rahmenbedingungen wie der unterlassenen Hilfeleistung (§ 323c StGB) und der Patientenverfügung (§ 1901a BGB) [2-4].\n    </p>\n  </div>\n\n  <!-- Sektion 1: ABCDE-Schema -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>1</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Systematische Beurteilung: ABCDE</h3>\n    </div>\n    \n    <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm'>\n      <div class='grid grid-cols-1 md:grid-cols-5 gap-4'>\n        <div class='p-4 bg-slate-50 rounded-xl border border-slate-100'>\n          <span class='block text-indigo-600 font-black text-xl mb-1'>A</span>\n          <span class='block text-[10px] font-bold text-slate-400 uppercase'>Airway</span>\n          <p class='text-xs text-slate-600 mt-2 italic font-medium'>Atemwege frei? Kontrolle Mundraum [3].</p>\n        </div>\n        <div class='p-4 bg-slate-50 rounded-xl border border-slate-100'>\n          <span class='block text-indigo-600 font-black text-xl mb-1'>B</span>\n          <span class='block text-[10px] font-bold text-slate-400 uppercase'>Breathing</span>\n          <p class='text-xs text-slate-600 mt-2 italic font-medium'>Atmung vorhanden? Frequenz (12-20/min) [3, 5].</p>\n        </div>\n        <div class='p-4 bg-slate-50 rounded-xl border border-slate-100'>\n          <span class='block text-indigo-600 font-black text-xl mb-1'>C</span>\n          <span class='block text-[10px] font-bold text-slate-400 uppercase'>Circulation</span>\n          <p class='text-xs text-slate-600 mt-2 italic font-medium'>Kreislauf: Puls, RR, Hautfarbe [3, 6].</p>\n        </div>\n        <div class='p-4 bg-slate-50 rounded-xl border border-slate-100'>\n          <span class='block text-indigo-600 font-black text-xl mb-1'>D</span>\n          <span class='block text-[10px] font-bold text-slate-400 uppercase'>Disability</span>\n          <p class='text-xs text-slate-600 mt-2 italic font-medium'>Neurologie: Bewusstsein, Pupillen, BZ [3, 7].</p>\n        </div>\n        <div class='p-4 bg-slate-50 rounded-xl border border-slate-100'>\n          <span class='block text-indigo-600 font-black text-xl mb-1'>E</span>\n          <span class='block text-[10px] font-bold text-slate-400 uppercase'>Environment</span>\n          <p class='text-xs text-slate-600 mt-2 italic font-medium'>Umgebung: Temperatur, Verletzungen [3, 8].</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 2: Bewusstseinsstörungen -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>2</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Stufendiagnostik Bewusstsein</h3>\n    </div>\n\n    <div class='bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden'>\n      <table class='w-full text-left border-collapse'>\n        <thead class='bg-slate-50'>\n          <tr>\n            <th class='px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest'>Zustand</th>\n            <th class='px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest'>Definition & Reaktion</th>\n          </tr>\n        </thead>\n        <tbody class='divide-y divide-slate-100 text-sm'>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-900 italic'>Somnolenz</td>\n            <td class='px-6 py-4 text-slate-600'>Leichte Bewusstseinstrübung; Patient ist auf Ansprache erweckbar [9].</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-900 italic'>Sopor</td>\n            <td class='px-6 py-4 text-slate-600'>Starke Störung; keine Reaktion auf Ansprache, aber Reaktion auf Schmerzreize (z. B. Reiben über Brustbein) [10, 11].</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-900 italic text-red-600'>Koma</td>\n            <td class='px-6 py-4 text-slate-600 font-medium'>Tiefste Bewusstlosigkeit; keine Schutzreflexe vorhanden, lebensbedrohlich [11].</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- Sektion 3: Reanimation (Highlight-Card) -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>3</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>HLW Guidelines 2021</h3>\n    </div>\n\n    <div class='bg-slate-900 text-white p-8 rounded-[2rem] shadow-xl relative overflow-hidden'>\n      <div class='absolute -right-10 -top-10 w-40 h-40 bg-indigo-500/20 rounded-full blur-3xl'></div>\n      <div class='relative z-10 grid grid-cols-1 md:grid-cols-2 gap-8'>\n        <div>\n          <h4 class='text-indigo-400 font-black text-sm uppercase mb-4 tracking-widest'>Kernsäulen der Thoraxkompression</h4>\n          <ul class='space-y-3 text-sm'>\n            <li class='flex items-center gap-3'><span class='w-1.5 h-1.5 bg-indigo-500 rounded-full'></span> <strong>Druckpunkt:</strong> Mitte des Brustkorbs auf nackter Haut [4]</li>\n            <li class='flex items-center gap-3'><span class='w-1.5 h-1.5 bg-indigo-500 rounded-full'></span> <strong>Drucktiefe:</strong> 5 - 6 cm [4]</li>\n            <li class='flex items-center gap-3'><span class='w-1.5 h-1.5 bg-indigo-500 rounded-full'></span> <strong>Frequenz:</strong> 100 - 120 / Minute [4]</li>\n            <li class='flex items-center gap-3'><span class='w-1.5 h-1.5 bg-indigo-500 rounded-full'></span> <strong>Unterlage:</strong> Reanimationsbrett zwingend erforderlich [4]</li>\n          </ul>\n        </div>\n        <div class='bg-white/5 p-5 rounded-2xl border border-white/10'>\n          <h4 class='text-indigo-300 font-black text-xs uppercase mb-3'>Reversible Ursachen (H's & HITS)</h4>\n          <p class='text-xs leading-relaxed text-slate-300'>\n            Prüfung auf Hypoxie, Hypovolämie, Herzbeuteltamponade, Intoxikation, Thromboembolie und Spannungspneumothorax [12].\n          </p>\n          <div class='mt-4 p-3 bg-indigo-500/20 rounded-xl text-[10px] uppercase font-bold tracking-widest text-center border border-indigo-500/30'>\n            Wechsel alle 2 Minuten empfohlen\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 4: Spezielle Notfallbilder -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>4</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Klinische Differenzierung</h3>\n    </div>\n\n    <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>\n      <!-- Schlaganfall -->\n      <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm'>\n        <h4 class='text-slate-900 font-black text-sm uppercase mb-4 border-b border-slate-100 pb-2'>Schlaganfall (Stroke)</h4>\n        <div class='space-y-2 text-xs'>\n          <div class='flex justify-between p-2 bg-red-50 rounded-lg text-red-700 font-bold'><span>Hängender Mundwinkel</span><span>A</span></div>\n          <div class='flex justify-between p-2 bg-red-50 rounded-lg text-red-700 font-bold'><span>Halbseitenlähmung</span><span>B</span></div>\n          <div class='flex justify-between p-2 bg-red-50 rounded-lg text-red-700 font-bold'><span>Sprachstörungen</span><span>C</span></div>\n          <p class='text-[10px] text-slate-500 pt-2 italic'>Maßnahmen: BZ-Kontrolle, RR-Messung, Notruf [13].</p>\n        </div>\n      </div>\n      <!-- Herzinfarkt -->\n      <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm'>\n        <h4 class='text-slate-900 font-black text-sm uppercase mb-4 border-b border-slate-100 pb-2'>Herzinfarkt: Gender-Aspekte</h4>\n        <div class='grid grid-cols-2 gap-4 text-[10px]'>\n          <div class='space-y-1'>\n            <span class='font-black text-blue-600 uppercase tracking-tighter'>Männer</span>\n            <ul class='text-slate-500 list-disc pl-3'>\n              <li>Brustschmerz</li>\n              <li>Ausstrahlung Kiefer/Arm</li>\n              <li>Todesangst [1]</li>\n            </ul>\n          </div>\n          <div class='space-y-1'>\n            <span class='font-black text-pink-600 uppercase tracking-tighter'>Frauen</span>\n            <ul class='text-slate-500 list-disc pl-3'>\n              <li>Übelkeit / Erbrechen</li>\n              <li>Rückenschmerzen</li>\n              <li>Luftnot [1, 6]</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 5: Equipment & Telereanimation -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>5</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Notfall-Support</h3>\n    </div>\n    \n    <div class='bg-indigo-50 border border-indigo-100 p-6 rounded-3xl'>\n      <div class='flex flex-col md:flex-row justify-between items-start md:items-center gap-6'>\n        <div class='space-y-2'>\n          <h5 class='text-indigo-900 font-black uppercase text-sm'>Telereanimation</h5>\n          <p class='text-xs text-indigo-700 font-medium leading-relaxed max-w-md'>\n            Anleitung zur Herz-Lungen-Wiederbelebung durch den Leitstellen-Disponenten via Telefon bis zum Eintreffen des Rettungsdienstes [2].\n          </p>\n        </div>\n        <div class='bg-white px-6 py-4 rounded-2xl border border-indigo-200 shadow-sm'>\n          <span class='text-[10px] font-black text-slate-400 uppercase block mb-1'>O2-Berechnungs-Formel [14]</span>\n          <code class='text-indigo-600 font-mono font-bold text-sm'>(Liter * bar) / Bedarf = Min.</code>\n        </div>\n      </div>\n    </div>\n  </div>\n\n</div>"
  }
]
