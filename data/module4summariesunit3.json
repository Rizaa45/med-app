[
{
'id': 3,
'topic': 'Die pathologische Schwangerschaft',
'tags': ['Gestosen', 'Präeklampsie', 'HELLP-Syndrom', 'Hyperemesis'],
'content': '<div class=\'space-y-8 text-slate-800\'>\n\n  <div class=\'bg-green-50 border-l-4 border-green-600 p-5 rounded-r-xl shadow-sm\'>\n    <p class=\'text-green-800 leading-relaxed\'>\n      Obwohl Schwangerschaft ein physiologischer Prozess ist („Ich bin schwanger und nicht krank!“), können Komplikationen in unterschiedlichen Schweregraden auftreten. Pathologische Verläufe erfordern einen <b>hohen Begleitungsbedarf</b> durch Beratung, Anleitung und engmaschige medizinische Überwachung.\n    </p>\n  </div>\n\n  <section>\n    <h2 class=\'text-indigo-900 font-bold text-xl mb-4 pb-2 border-b border-indigo-300\'>1. Ursachen und Einteilung von Komplikationen</h2>\n    <div class=\'grid grid-cols-1 md:grid-cols-2 gap-4\'>\n      <div class=\'bg-white p-4 rounded-xl border border-slate-200 shadow-sm\'>\n        <h3 class=\'text-green-600 font-semibold mb-2\'>Schwangerschaftsspezifisch</h3>\n        <ul class=\'text-sm space-y-1 list-disc list-inside text-slate-600\'>\n          <li>Extrauteringravidität (Eileiterschwangerschaft)</li>\n          <li>Abort oder Schwangerschaftsabbruch</li>\n          <li>Plazentainsuffizienz oder vorzeitige Ablösung</li>\n          <li>Gestosen (schwangerschaftsbedingte Erkrankungen)</li>\n        </ul>\n      </div>\n      <div class=\'bg-white p-4 rounded-xl border border-slate-200 shadow-sm\'>\n        <h3 class=\'text-indigo-900 font-semibold mb-2\'>Kindlich & Metabolisch</h3>\n        <ul class=\'text-sm space-y-1 list-disc list-inside text-slate-600\'>\n          <li>Frühgeburt oder Übertragung</li>\n          <li>Störungen des Glukosestoffwechsels</li>\n          <li>Pathologische Entwicklung des Kindes</li>\n          <li>Blutgruppenunverträglichkeiten</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  <section>\n    <h2 class=\'text-indigo-900 font-bold text-xl mb-4 pb-2 border-b border-indigo-300\'>2. Frühgestose: Hyperemesis gravidarum</h2>\n    <div class=\'space-y-4\'>\n      <p class=\'text-sm\'>Übermäßiges Schwangerschaftserbrechen im ersten Trimenon (ab 6. SSW), das über die typische morgendliche Übelkeit hinausgeht.</p>\n      <div class=\'bg-red-50 p-4 rounded-xl border border-red-200\'>\n        <h4 class=\'text-red-800 font-bold text-sm mb-2 flex items-center\'>\n          <span class=\'mr-2\'>🚨</span> Leitsymptome & Komplikationen\n        </h4>\n        <div class=\'grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-red-700\'>\n          <li><b>Metabolische Azidose:</b> Durch Kohlenhydratmangel und Azetongeruch im Atem.</li>\n          <li><b>Organschäden:</b> Leberschäden mit Ikterus (Gelbfärbung).</li>\n          <li><b>ZNS-Beteiligung:</b> Mögliche Verwirrtheitszustände.</li>\n          <li><b>Kreislauf:</b> Tachykardie und Hypotonie durch Flüssigkeitsverlust.</li>\n        </div>\n      </div>\n      <div class=\'bg-white p-4 rounded-xl border border-slate-200\'>\n        <h4 class=\'font-semibold text-green-700 mb-2\'>Pflegerische Maßnahmen</h4>\n        <ul class=\'text-xs space-y-1 list-disc list-inside text-slate-600\'>\n          <li>Psychische Unterstützung und Vermeidung von Konfliktgesprächen.</li>\n          <li>Langsamer Kostaufbau nach verordneter Nahrungskarenz.</li>\n          <li>Beseitigung von Reizen (Erbrechen-Utensilien wegräumen).</li>\n          <li>Mundinspektion und Thromboseprophylaxe.</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  <section>\n    <h2 class=\'text-indigo-900 font-bold text-xl mb-4 pb-2 border-b border-indigo-300\'>3. Spätgestosen: SIH, Präeklampsie & Eklampsie</h2>\n    <div class=\'overflow-x-auto\'>\n      <table class=\'w-full bg-white border border-slate-200 rounded-2xl overflow-hidden\'>\n        <thead class=\'bg-indigo-900 text-white text-xs\'>\n          <tr>\n            <th class=\'px-4 py-2 text-left\'>Erkrankung</th>\n            <th class=\'px-4 py-2 text-left\'>Symptomatik (Leitsymptome)</th>\n            <th class=\'px-4 py-2 text-left\'>Klinischer Status</th>\n          </tr>\n        </thead>\n        <tbody class=\'divide-y divide-slate-100 text-xs\'>\n          <tr>\n            <td class=\'px-4 py-3 font-semibold text-green-800\'>SIH</td>\n            <td class=\'px-4 py-3\'>Blutdruck > 140/90 mmHg ohne Proteinurie.</td>\n            <td class=\'px-4 py-3 italic\'>Oft beschwerdefrei.</td>\n          </tr>\n          <tr>\n            <td class=\'px-4 py-3 font-semibold text-green-800\'>Präeklampsie</td>\n            <td class=\'px-4 py-3\'><b>EPH-Gestose:</b> Edema (Ödeme), Proteinurie (>300mg/24h), Hypertonie.</td>\n            <td class=\'px-4 py-3 font-medium\'>Gefahr der Plazentainsuffizienz.</td>\n          </tr>\n          <tr>\n            <td class=\'px-4 py-3 font-semibold text-red-600\'>Eklampsie</td>\n            <td class=\'px-4 py-3 text-red-700 bg-red-50\'><b>Absoluter Notfall:</b> Tonisch-klonische Krämpfe und Bewusstlosigkeit.</td>\n            <td class=\'px-4 py-3 text-red-700 bg-red-50 font-bold\'>Lebensgefahr für Mutter & Kind.</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section>\n    <h2 class=\'text-indigo-900 font-bold text-xl mb-4 pb-2 border-b border-indigo-300\'>4. Sonderform: HELLP-Syndrom</h2>\n    <div class=\'p-4 bg-indigo-900 text-white rounded-xl shadow-lg\'>\n      <div class=\'flex items-center mb-3\'>\n        <span class=\'text-indigo-300 font-mono text-lg mr-3\'>H-E-LL-P</span>\n        <span class=\'text-xs opacity-80\'>Hämolyse | Elevated Liver enzymes | Low Platelets</span>\n      </div>\n      <p class=\'text-sm leading-relaxed mb-4\'>\n        Kann sich ohne vorherige Gestose-Symptome entwickeln. Leitsymptom ist häufig <b>akuter Oberbauchschmerz</b>.\n      </p>\n      <div class=\'bg-indigo-800 p-3 rounded-lg border border-indigo-700 text-xs\'>\n        <b>Risiko:</b> Aufgrund der Thrombozytopenie (Blutplättchenmangel) besteht eine massive Gefahr für postoperative Blutungen, z.B. nach einer Sectio.\n      </div>\n    </div>\n  </section>\n\n  <section>\n    <h2 class=\'text-indigo-900 font-bold text-xl mb-4 pb-2 border-b border-indigo-300\'>5. Diagnostik und Pflegeschwerpunkte</h2>\n    <div class=\'grid grid-cols-1 md:grid-cols-2 gap-6\'>\n      <div class=\'space-y-3\'>\n        <h4 class=\'font-semibold text-sm text-indigo-900 ml-2\'>Überwachung & Diagnostik</h4>\n        <ul class=\'text-xs space-y-1 list-disc list-inside text-slate-600\'>\n          <li>Blut (Nieren-/Leberwerte, Gerinnung)</li>\n          <li>Urin (Protein & Glukose)</li>\n          <li>CTG & Doppler-Sonografie (Plazenta/Wachstum)</li>\n        </ul>\n      </div>\n      <div class=\'space-y-3\'>\n        <h4 class=\'font-semibold text-sm text-green-700 ml-2\'>Pflege bei Präeklampsie</h4>\n        <ul class=\'text-xs space-y-1 list-disc list-inside text-slate-600\'>\n          <li>Überwiegend <b>Linkslagerung</b> der Patientin.</li>\n          <li>Reizabschirmung und absolute Ruhe.</li>\n          <li>Tägliche Gewichts- und Ödemkontrollen.</li>\n          <li>Strenge Flüssigkeitsbilanzierung.</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  <section>\n    <h2 class=\'text-indigo-900 font-bold text-xl mb-4 pb-2 border-b border-indigo-300\'>6. Noxen und Entwicklungsstörungen</h2>\n    <div class=\'bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-inner\'>\n      <div class=\'grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs\'>\n        <div>\n          <p class=\'font-bold text-indigo-900\'>Embryopathie (18. Tag – 8. SSW)</p>\n          <p class=\'italic text-slate-500 mb-1\'>Störung der Organanlage</p>\n          <p>Beispiele: Spina bifida, Lippenkiefergaumenspalte, Rötelnembryopathie.</p>\n        </div>\n        <div>\n          <p class=\'font-bold text-indigo-900\'>Fetopathie (ab 9. SSW)</p>\n          <p class=\'italic text-slate-500 mb-1\'>Reifungsstörung</p>\n          <p>Beispiele: Zytomegalie, Fehlbildungen durch Suchtmittel (FAS).</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</div>'
}
