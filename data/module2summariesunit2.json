[
  {
    "id": 2,
    "title": "Anatomie und Physiologie des Bewegungsapparates",
    "tags": [
      "Skelettsystem",
      "Gelenkarten",
      "Muskelphysiologie",
      "Wirbelsäule"
    ],
    "content": "<div class='space-y-10 pb-10'>\n\n  <!-- Header-Box -->\n  <div class='bg-indigo-50 p-8 rounded-3xl border border-indigo-100 shadow-sm'>\n    <h2 class='text-2xl font-black text-indigo-900 mb-2 uppercase tracking-tight'>System-Überblick</h2>\n    <p class='text-indigo-700 leading-relaxed font-medium'>\n      Der menschliche Bewegungsapparat gliedert sich in ein passives System (Skelett und Gelenke) und ein aktives System (Skelettmuskulatur). Er dient der Stützung, dem Schutz innerer Organe sowie der Realisierung komplexer Bewegungsabläufe unter nervaler Steuerung.\n    </p>\n  </div>\n\n  <!-- Sektion 1: Das Skelettsystem -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>1</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Passiver Apparat: Das Skelett</h3>\n    </div>\n    \n    <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm'>\n      <div class='grid grid-cols-1 md:grid-cols-3 gap-6 text-sm'>\n        <div class='space-y-2'>\n          <span class='font-black text-indigo-600 uppercase text-xs tracking-widest'>Knochenanzahl</span>\n          <p class='text-slate-600'>Besteht aus mehr als <strong>200 Knochen</strong>.</p>\n        </div>\n        <div class='space-y-2'>\n          <span class='font-black text-indigo-600 uppercase text-xs tracking-widest'>Gewichtsanteil</span>\n          <p class='text-slate-600'>Macht ca. <strong>12 % des Körpergewichts</strong> aus.</p>\n        </div>\n        <div class='space-y-2'>\n          <span class='font-black text-indigo-600 uppercase text-xs tracking-widest'>Hauptaufgaben</span>\n          <p class='text-slate-600 italic'>Stützfunktion, Schutz der Organe, Mineralspeicher.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Highlight: Knochenaufbau -->\n    <div class='bg-slate-900 text-white p-8 rounded-[2rem] shadow-xl'>\n      <h4 class='text-indigo-400 font-black text-sm uppercase mb-4 tracking-widest text-center md:text-left'>Histologie des Knochens</h4>\n      <div class='grid grid-cols-1 md:grid-cols-2 gap-8'>\n        <div class='bg-white/5 p-5 rounded-2xl border border-white/10'>\n          <span class='block font-bold text-indigo-300 mb-2 underline decoration-indigo-500/50 underline-offset-4'>Periost (Knochenhaut)</span>\n          <p class='text-xs leading-relaxed text-slate-300'>Umhüllt alle Knochen; enthält Blutgefäße zur Ernährung des Gewebes und Nerven (Schmerzempfinden).</p>\n        </div>\n        <div class='bg-white/5 p-5 rounded-2xl border border-white/10'>\n          <span class='block font-bold text-indigo-300 mb-2 underline decoration-indigo-500/50 underline-offset-4'>Spongiosa vs. Kompakta</span>\n          <p class='text-xs leading-relaxed text-slate-300'><strong>Kompakta:</strong> Harte Außenhülle (Lamellen).<br><strong>Spongiosa:</strong> Innere Knochenbälkchen; Belastbarkeit sinkt massiv bei Osteoporose.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 2: Gelenklehre -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>2</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Arthrologie (Gelenkarten)</h3>\n    </div>\n\n    <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>\n      <div class='bg-white border border-slate-200 p-5 rounded-2xl shadow-sm'>\n        <h4 class='font-black text-slate-900 text-xs uppercase mb-4'>Synarthrosen (Unechte Gelenke)</h4>\n        <ul class='space-y-2 text-xs text-slate-600'>\n          <li class='flex justify-between border-b pb-1'><span>Knöchern (Synostosen)</span><span class='font-bold italic'>Kreuzbeinwirbel</span></li>\n          <li class='flex justify-between border-b pb-1'><span>Knorpelig (Synchondrosen)</span><span class='font-bold italic'>Bandscheiben, Symphyse</span></li>\n          <li class='flex justify-between border-b pb-1'><span>Bindegewebig (Syndesmosen)</span><span class='font-bold italic'>Schädelnähte</span></li>\n        </ul>\n      </div>\n      <div class='bg-white border border-slate-200 p-5 rounded-2xl shadow-sm'>\n        <h4 class='font-black text-slate-900 text-xs uppercase mb-4'>Diarthrosen (Echte Gelenke)</h4>\n        <div class='overflow-x-auto'>\n          <table class='w-full text-left text-[10px]'>\n            <thead class='bg-slate-50 text-slate-500 font-black uppercase'>\n              <tr><th class='p-1.5'>Typ</th><th class='p-1.5'>Achsen</th><th class='p-1.5'>Beispiel</th></tr>\n            </thead>\n            <tbody class='divide-y divide-slate-100'>\n              <tr><td class='p-1.5 font-bold italic'>Kugelgelenk</td><td class='p-1.5 text-center italic'>3</td><td class='p-1.5'>Hüfte, Schulter</td></tr>\n              <tr><td class='p-1.5 font-bold italic'>Eigelenk</td><td class='p-1.5 text-center italic'>2</td><td class='p-1.5'>Handgelenk</td></tr>\n              <tr><td class='p-1.5 font-bold italic'>Sattelgelenk</td><td class='p-1.5 text-center italic'>2</td><td class='p-1.5'>Daumengrundgelenk</td></tr>\n              <tr><td class='p-1.5 font-bold italic'>Scharniergelenk</td><td class='p-1.5 text-center italic'>1</td><td class='p-1.5'>Ellbogen (Ulnar)</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 3: Wirbelsäule und Thorax -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>3</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Achsenskelett: Wirbelsäule & Thorax</h3>\n    </div>\n\n    <div class='bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden'>\n      <table class='w-full text-left'>\n        <thead class='bg-slate-50'>\n          <tr>\n            <th class='px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest'>Segment</th>\n            <th class='px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest'>Wirbelanzahl / Aufbau</th>\n            <th class='px-6 py-4 text-xs font-black text-slate-500 uppercase tracking-widest'>Physiol. Krümmung</th>\n          </tr>\n        </thead>\n        <tbody class='divide-y divide-slate-100 text-sm'>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700 italic text-xs'>HWS</td>\n            <td class='px-6 py-4 text-slate-600 text-xs'>7 Wirbel (Atlas & Axis)</td>\n            <td class='px-6 py-4 text-slate-600 text-xs italic font-medium text-indigo-600'>Lordose</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700 italic text-xs'>BWS</td>\n            <td class='px-6 py-4 text-slate-600 text-xs'>12 Wirbel (verknüpft mit Costae)</td>\n            <td class='px-6 py-4 text-slate-600 text-xs italic font-medium text-orange-600'>Kyphose</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700 italic text-xs'>LWS</td>\n            <td class='px-6 py-4 text-slate-600 text-xs'>5 Wirbel (große Körper)</td>\n            <td class='px-6 py-4 text-slate-600 text-xs italic font-medium text-indigo-600'>Lordose</td>\n          </tr>\n          <tr>\n            <td class='px-6 py-4 font-bold text-slate-700 italic text-xs text-slate-400'>Thorax</td>\n            <td colspan='2' class='px-6 py-4 text-slate-600 text-[10px]'>12 Rippenpaare, Sternum (Manubrium, Corpus, Xyphoid)</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n  <!-- Sektion 4: Aktiver Bewegungsapparat -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>4</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Skelettmuskulatur & Physiologie</h3>\n    </div>\n\n    <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>\n      <div class='bg-white border border-slate-200 p-6 rounded-3xl shadow-sm'>\n        <h4 class='font-black text-slate-800 mb-4 border-b pb-2 text-xs italic uppercase tracking-tighter'>Muskelkontraktion (Gleit-Filament)</h4>\n        <ol class='text-[11px] text-slate-500 space-y-2 list-decimal pl-4'>\n          <li>Kalzium-Ausschüttung triggert den Prozess.</li>\n          <li>Myosinköpfchen bindet an Aktin.</li>\n          <li>Aktin wird bewegt (Kraftschlag).</li>\n          <li>Lösung der Bindung unter <strong>Verbrauch von ATP</strong>.</li>\n        </ol>\n      </div>\n      <div class='bg-slate-900 text-white p-6 rounded-3xl shadow-lg'>\n        <h4 class='font-black text-indigo-400 mb-4 text-xs uppercase italic tracking-tighter'>Klinischer Fokus: Bewegungbeobachtung</h4>\n        <div class='grid grid-cols-2 gap-2 text-[10px]'>\n          <div class='p-2 bg-white/5 rounded-lg'>Körperhaltung</div>\n          <div class='p-2 bg-white/5 rounded-lg'>Gangbild</div>\n          <div class='p-2 bg-white/5 rounded-lg'>Muskelkraft (Arbeit)</div>\n          <div class='p-2 bg-white/5 rounded-lg'>Muskeltonus (Spannung)</div>\n        </div>\n        <p class='text-[9px] text-slate-400 mt-4 italic italic'>Besonders relevant bei Parkinson (Rigor, Tremor, Hypokinese).</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 5: Orientierung im Raum -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>5</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Anatomische Ebenen & Achsen</h3>\n    </div>\n\n    <div class='bg-indigo-50 border border-indigo-100 p-6 rounded-3xl'>\n      <div class='grid grid-cols-1 md:grid-cols-2 gap-8'>\n        <div class='space-y-3'>\n          <span class='font-black text-indigo-900 text-xs uppercase tracking-widest'>Die 3 Hauptebenen</span>\n          <ul class='text-xs space-y-1 text-slate-600 font-medium'>\n            <li>• <strong>Sagittalebene:</strong> Teilt in Links/Rechts (Mediansagittal).</li>\n            <li>• <strong>Frontalebene:</strong> Teilt in Vorne/Hinten.</li>\n            <li>• <strong>Transversalebene:</strong> Teilt in Oben/Unten.</li>\n          </ul>\n        </div>\n        <div class='bg-white p-5 rounded-2xl border border-indigo-200 shadow-sm'>\n          <span class='font-black text-indigo-900 text-xs uppercase block mb-3 italic tracking-tighter'>Richtungsbezeichnungen</span>\n          <div class='grid grid-cols-2 gap-x-4 gap-y-1 text-[10px] font-mono'>\n            <span class='text-indigo-600'>Kranial:</span><span class='text-slate-500'>kopfwärts</span>\n            <span class='text-indigo-600'>Kaudal:</span><span class='text-slate-500'>steißwärts</span>\n            <span class='text-indigo-600'>Proximal:</span><span class='text-slate-500'>rumpfnah</span>\n            <span class='text-indigo-600'>Distal:</span><span class='text-slate-500'>rumpffern</span>\n            <span class='text-indigo-600'>Ventral:</span><span class='text-slate-500'>bauchwärts</span>\n            <span class='text-indigo-600'>Dorsal:</span><span class='text-slate-500'>rückenwärts</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n</div>"
  }
]
