[
  {
    "id": 3,
    "title": "Neurologie und neurologische Krankheitsbilder",
    "tags": [
      "Zentralnervensystem",
      "Schlaganfall",
      "Parkinson-Syndrom",
      "Blutversorgung",
      "Neuroanatomie"
    ],
    "content": "<div class='space-y-10 pb-10'>\n\n  <!-- Header-Box -->\n  <div class='bg-indigo-50 p-8 rounded-3xl border border-indigo-100 shadow-sm'>\n    <h2 class='text-2xl font-black text-indigo-900 mb-2 uppercase tracking-tight'>Neuro-Zusammenfassung</h2>\n    <p class='text-indigo-700 leading-relaxed font-medium'>\n      Die Neurologie umfasst die Lehre vom Aufbau und den Erkrankungen des Nervensystems. Für die Pflegepraxis ist das Verständnis der anatomischen Gliederung (ZNS/PNS), der Liquordynamik sowie der Leitsymptome von Schlaganfall und Parkinson essenziell, um neurologische Defizite frühzeitig zu erkennen und adäquat zu handeln.\n    </p>\n  </div>\n\n  <!-- Sektion 1: Gliederung des Nervensystems -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>1</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Strukturelle Organisation</h3>\n    </div>\n    \n    <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>\n      <div class='bg-white border border-slate-200 p-5 rounded-2xl shadow-sm'>\n        <h4 class='text-indigo-600 font-black text-xs uppercase mb-3 tracking-widest text-center'>Zentralnervensystem (ZNS)</h4>\n        <ul class='text-slate-600 text-sm space-y-2'>\n          <li class='flex items-center gap-2'><i class='fas fa-check text-indigo-500 text-[10px]'></i> <strong>Gehirn (Cerebrum):</strong> Ca. 100 Mrd. Neurone.</li>\n          <li class='flex items-center gap-2'><i class='fas fa-check text-indigo-500 text-[10px]'></i> <strong>Rückenmark:</strong> Im Wirbelkanal, 31 Segmente.</li>\n          <li class='text-[10px] text-slate-400 italic mt-2'>Zuständig für Reizverarbeitung und Steuerung.</li>\n        </ul>\n      </div>\n      <div class='bg-white border border-slate-200 p-5 rounded-2xl shadow-sm'>\n        <h4 class='text-indigo-600 font-black text-xs uppercase mb-3 tracking-widest text-center'>Peripheres Nervensystem (PNS)</h4>\n        <ul class='text-slate-600 text-sm space-y-2'>\n          <li class='flex items-center gap-2'><i class='fas fa-link text-indigo-500 text-[10px]'></i> <strong>12 Hirnnervenpaare:</strong> Ein-/Austritt am Hirnstamm.</li>\n          <li class='flex items-center gap-2'><i class='fas fa-link text-indigo-500 text-[10px]'></i> <strong>31 Spinalnervenpaare:</strong> Austritt zwischen Wirbeln.</li>\n          <li class='text-[10px] text-slate-400 italic mt-2'>Verbindung des Körpers mit dem ZNS.</li>\n        </ul>\n      </div>\n    </div>\n    \n    <!-- Vegetatives Nervensystem Info-Card -->\n    <div class='bg-white border border-slate-200 p-5 rounded-2xl shadow-sm border-l-4 border-l-indigo-600'>\n      <h4 class='text-slate-900 font-black text-xs uppercase mb-2 italic'>Vegetatives Nervensystem (VNS)</h4>\n      <p class='text-slate-600 text-sm leading-relaxed'>\n        Das <strong>unwillkürliche Nervensystem</strong> arbeitet ohne Beteiligung des Bewusstseins. Es koordiniert lebenswichtige Organtätigkeiten wie Atmung und Verdauung und ist im gesamten Körper verteilt.\n      </p>\n    </div>\n  </div>\n\n  <!-- Sektion 2: Gehirnanatomie & Schutz -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>2</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Gehirn & Schutzsysteme</h3>\n    </div>\n\n    <div class='bg-slate-900 text-white p-8 rounded-[2rem] shadow-xl'>\n      <div class='grid grid-cols-1 md:grid-cols-2 gap-8'>\n        <div>\n          <h4 class='text-indigo-400 font-black text-xs uppercase mb-4 tracking-widest'>Anatomische Gliederung</h4>\n          <div class='space-y-3 text-sm'>\n            <div class='flex justify-between border-b border-white/10 pb-1'><span>Großhirn</span><span class='text-indigo-300 italic text-[10px]'>Encephalon</span></div>\n            <div class='flex justify-between border-b border-white/10 pb-1'><span>Zwischenhirn</span><span class='text-indigo-300 italic text-[10px]'>Diencephalon</span></div>\n            <div class='flex justify-between border-b border-white/10 pb-1'><span>Hirnstamm</span><span class='text-indigo-300 italic text-[10px]'>Mittelhirn, Brücke, Medulla obl.</span></div>\n            <div class='flex justify-between border-b border-white/10 pb-1'><span>Kleinhirn</span><span class='text-indigo-300 italic text-[10px]'>Cerebellum (Gleichgewicht)</span></div>\n          </div>\n        </div>\n        <div class='bg-white/5 p-5 rounded-2xl border border-white/10'>\n          <h4 class='text-indigo-300 font-black text-xs uppercase mb-3 italic tracking-tighter'>Meningen (Hirnhäute)</h4>\n          <div class='space-y-2 text-xs'>\n            <div class='p-2 bg-white/5 rounded-lg'><strong>Dura mater:</strong> Harte Haut, fest mit Schädel verwachsen.</div>\n            <div class='p-2 bg-white/5 rounded-lg'><strong>Arachnoidea:</strong> Spinngewebshaut, gefäßlos.</div>\n            <div class='p-2 bg-white/5 rounded-lg'><strong>Pia mater:</strong> Weiche Haut, zart und gefäßführend.</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 3: Liquorsystem & Blutversorgung -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>3</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Versorgung & Dynamik</h3>\n    </div>\n\n    <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>\n      <!-- Blutversorgung -->\n      <div class='bg-white border border-slate-200 p-6 rounded-3xl shadow-sm'>\n        <h4 class='font-black text-slate-800 mb-4 border-b pb-2 text-xs uppercase'>Circulus Arteriosus (Gefäßring)</h4>\n        <table class='w-full text-[10px]'>\n          <tbody class='divide-y divide-slate-100'>\n            <tr><td class='py-2 font-bold text-indigo-600'>A. cerebri anterior</td><td class='py-2'>Innenfläche Großhirn</td></tr>\n            <tr><td class='py-2 font-bold text-indigo-600'>A. cerebri media</td><td class='py-2'>Schläfen-/Scheitellappen</td></tr>\n            <tr><td class='py-2 font-bold text-indigo-600'>A. cerebri posterior</td><td class='py-2'>Hinterhauptlappen</td></tr>\n            <tr><td class='py-2 font-bold text-indigo-600 italic' colspan='2 text-right text-slate-400'>Zufuhr: A. carotis interna & A. vertebralis</td></tr>\n          </tbody>\n        </table>\n      </div>\n\n      <!-- Liquor-Fakten -->\n      <div class='bg-white border border-slate-200 p-6 rounded-3xl shadow-sm relative overflow-hidden'>\n         <div class='absolute -right-4 -bottom-4 opacity-5'><i class='fas fa-tint text-6xl'></i></div>\n         <h4 class='font-black text-slate-800 mb-4 border-b pb-2 text-xs uppercase italic'>Liquor cerebrospinalis</h4>\n         <ul class='text-xs space-y-3 text-slate-600'>\n           <li class='flex justify-between'><span>Produktionsort:</span><span class='font-bold'>Plexus choroidei</span></li>\n           <li class='flex justify-between'><span>Tagesmenge:</span><span class='font-bold'>500 – 700 ml</span></li>\n           <li class='flex justify-between'><span>Bestandteile:</span><span class='font-bold italic text-[9px]'>Glucose, Eiweiß, Lymphozyten</span></li>\n           <li class='flex justify-between text-indigo-600 font-bold'><span>Gesamtvolumen:</span><span>120 – 200 ml</span></li>\n         </ul>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 4: Neurologische Krankheitsbilder -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>4</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Klinische Leitsymptomatik</h3>\n    </div>\n\n    <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>\n      <!-- Schlaganfall Highlights -->\n      <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm'>\n        <h4 class='text-red-600 font-black text-sm uppercase mb-4 border-b border-red-50 pb-2 flex justify-between items-center'>\n          <span>Schlaganfall (Stroke)</span>\n          <i class='fas fa-clock text-xs'></i>\n        </h4>\n        <div class='space-y-2 text-[11px] font-medium'>\n          <div class='flex items-center gap-2 text-slate-700 bg-red-50/50 p-2 rounded-lg'><span class='w-1 h-1 bg-red-600 rounded-full'></span> Hängender Mundwinkel / Augenlid</div>\n          <div class='flex items-center gap-2 text-slate-700 bg-red-50/50 p-2 rounded-lg'><span class='w-1 h-1 bg-red-600 rounded-full'></span> Halbseitenlähmung (Hemiparese)</div>\n          <div class='flex items-center gap-2 text-slate-700 bg-red-50/50 p-2 rounded-lg'><span class='w-1 h-1 bg-red-600 rounded-full'></span> Sprach- / Bewusstseinsstörungen</div>\n          <p class='text-[9px] text-slate-400 mt-2 italic'>Maßnahmen: BZ-Kontrolle, RR-Messung, Oberkörper 30° hoch.</p>\n        </div>\n      </div>\n\n      <!-- Parkinson-Syndrom -->\n      <div class='bg-white border border-slate-200 p-6 rounded-2xl shadow-sm'>\n        <h4 class='text-indigo-900 font-black text-sm uppercase mb-4 border-b border-slate-100 pb-2'>Parkinson-Syndrom</h4>\n        <div class='grid grid-cols-1 gap-2 text-[11px]'>\n           <div class='flex justify-between p-2 bg-indigo-50/50 rounded-lg text-indigo-900'><strong>Hypokinese / Akinese</strong><span class='italic text-[9px]'>Bewegungsarmut</span></div>\n           <div class='flex justify-between p-2 bg-indigo-50/50 rounded-lg text-indigo-900'><strong>Rigor</strong><span class='italic text-[9px]'>Muskelsteifigkeit</span></div>\n           <div class='flex justify-between p-2 bg-indigo-50/50 rounded-lg text-indigo-900'><strong>Tremor</strong><span class='italic text-[9px]'>Zittern (Ruhetremor)</span></div>\n           <div class='p-2 bg-slate-50 rounded-lg text-slate-500 text-[10px]'>Gangbild: kleinschrittig, vornübergeneigt, Knie gebeugt.</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Sektion 5: Funktionsprinzipien -->\n  <div class='space-y-6'>\n    <div class='flex items-center gap-4'>\n      <div class='bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black shadow-lg'>5</div>\n      <h3 class='text-xl font-black text-slate-800 uppercase tracking-wide'>Physiologische Mechanismen</h3>\n    </div>\n    \n    <div class='bg-indigo-900 text-white p-8 rounded-[2rem] shadow-xl relative overflow-hidden'>\n      <div class='absolute top-0 right-0 p-4 opacity-10 font-black text-7xl select-none italic'>REFLEX</div>\n      <h4 class='text-indigo-300 font-black text-xs uppercase mb-6 tracking-widest'>Der Reflexbogen (unwillkürliche Reaktion)</h4>\n      <div class='flex flex-col md:flex-row items-center gap-4 text-[10px] uppercase font-bold text-center'>\n        <div class='flex-1 p-3 bg-white/10 rounded-xl border border-white/20 w-full'>Rezeptor<br><span class='text-[8px] font-normal lowercase'>Reizaufnahme</span></div>\n        <i class='fas fa-arrow-right hidden md:block opacity-30'></i>\n        <div class='flex-1 p-3 bg-white/10 rounded-xl border border-white/20 w-full'>Sensibler Nerv<br><span class='text-[8px] font-normal lowercase'>Zuleitung</span></div>\n        <i class='fas fa-arrow-right hidden md:block opacity-30'></i>\n        <div class='flex-1 p-3 bg-indigo-500/30 rounded-xl border border-indigo-400/50 w-full'>Reflexzentrum<br><span class='text-[8px] font-normal lowercase'>Rückenmark (Umschaltung)</span></div>\n        <i class='fas fa-arrow-right hidden md:block opacity-30'></i>\n        <div class='flex-1 p-3 bg-white/10 rounded-xl border border-white/20 w-full'>Motorischer Nerv<br><span class='text-[8px] font-normal lowercase'>Ableitung</span></div>\n        <i class='fas fa-arrow-right hidden md:block opacity-30'></i>\n        <div class='flex-1 p-3 bg-white/10 rounded-xl border border-white/20 w-full'>Erfolgsorgan<br><span class='text-[8px] font-normal lowercase'>Muskelreaktion</span></div>\n      </div>\n    </div>\n  </div>\n\n</div>"
  }
]
